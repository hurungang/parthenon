# ============================================================
# Parthenon — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in the values for your
# deployment.
#
# CONFIGURATION PRIORITY (highest to lowest):
#   1. Environment variables / .env file (this file)
#   2. config/app.yaml — application-wide static defaults
#   3. config/identity.yaml — identity provider (setup-written)
#   4. Hard-coded field defaults in Settings class
#
# TIP: To see which source resolved each value, check the
# startup log for "resolved <connection> from <source>" lines.
#
# YAML OVERRIDE PATHS (optional):
#   APP_YAML_PATH=/etc/parthenon/app.yaml
#   IDENTITY_YAML_PATH=/etc/parthenon/identity.yaml
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
# Valid values for ENVIRONMENT: development | test | production
APP_NAME="Parthenon AI Harness"
ENVIRONMENT=development
DEBUG=false

# ════════════════════════════════════════════════════════════
# PostgreSQL
# ════════════════════════════════════════════════════════════
# Choose one approach:
#
#   (A) Full URL — simple, all-in-one:
#       DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db
#
#   (B) Per-component vars — easier for Kubernetes secrets:
#       POSTGRES_HOST=localhost
#       POSTGRES_PORT=5432
#       POSTGRES_USER=parthenon
#       POSTGRES_PASSWORD=parthenon
#       POSTGRES_DB=parthenon
#
# Per-component vars compose into the full URL automatically.
# If BOTH are set, per-component vars take priority.
# ════════════════════════════════════════════════════════════
DATABASE_URL=postgresql+asyncpg://parthenon:parthenon@localhost:5432/parthenon
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=parthenon
# POSTGRES_PASSWORD=parthenon
# POSTGRES_DB=parthenon

# ════════════════════════════════════════════════════════════
# Redis
# ════════════════════════════════════════════════════════════
# Same split as PostgreSQL — full URL or per-component.
# Per-component vars take priority when set.
# Used by: Control Center, Communication Hub
# ════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ------------------------------------------------------------
# Auth / OIDC
# ------------------------------------------------------------
# URL of the OIDC provider's realm/tenant.
# Keycloak bundled:  http://localhost:8082/realms/parthenon
# Azure EntraID:     https://login.microsoftonline.com/{tenant-id}/v2.0
# External Keycloak: https://sso.example.com/realms/myapp
OIDC_PROVIDER_URL=http://localhost:8082/realms/parthenon
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=RS256
JWT_AUDIENCE=parthenon

# ════════════════════════════════════════════════════════════
# Keycloak Admin Credentials — SETUP TOOL ONLY
# ════════════════════════════════════════════════════════════
# Used exclusively by the setup CLI and ``docker compose --profile setup run setup``.
# The Control Center runtime does NOT require or consume these variables.
# Required for: ``python -m setup.main identity``, ``python -m setup.main dev``
# Not required at runtime.
# ════════════════════════════════════════════════════════════
KEYCLOAK_URL=http://localhost:8082
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=parthenon
INITIAL_ADMIN_PASSWORD=admin

# ------------------------------------------------------------
# Super Admin (built-in fallback auth)
# ------------------------------------------------------------
# When enabled, allows login with SUPER_ADMIN_USERNAME / SUPER_ADMIN_PASSWORD
# bypassing OIDC.  Useful for initial setup before the identity provider is ready.
# PARTHENON_SUPER_ADMIN_ENABLED=true
# SUPER_ADMIN_USERNAME=admin
# SUPER_ADMIN_PASSWORD=admin
# SUPER_ADMIN_TOKEN_EXPIRY_SECONDS=900

# ------------------------------------------------------------
# Credential Vault (AES-256 — must be at least 32 bytes)
# ------------------------------------------------------------
CREDENTIAL_VAULT_KEY=change-me-32-byte-key-for-aes256!

# ============================================================
# Telemetry (TELEMETRY__* env vars override TelemetrySettings)
# ============================================================

# Active export targets (comma-separated list when using env vars).
# Supported: console, file, otlp, logfire, custom
# Default: otlp
# TELEMETRY__EXPORTERS='["otlp"]'

# Signal enable flags
# Type: bool | Default: true
# TELEMETRY__TRACES_ENABLED=true
# TELEMETRY__METRICS_ENABLED=true
# TELEMETRY__LOGS_ENABLED=true

# Service name attached to all OTEL spans / metrics / logs
# Type: str | Default: "parthenon-api"
# TELEMETRY__SERVICE_NAME=parthenon-api

# HTTP client (httpx/httpcore) log level during normal operation.
# Default: WARNING (silent).  Set to DEBUG to see full HTTP wire traffic.
# TELEMETRY__HTTP_CLIENT_LOG_LEVEL=WARNING

# ── OTLP exporter ────────────────────────────────────────────
# TELEMETRY__OTLP__ENDPOINT=http://localhost:4317
# TELEMETRY__OTLP__PROTOCOL=grpc         # grpc | http
# TELEMETRY__OTLP__INSECURE=true

# ── File exporter ─────────────────────────────────────────────
# TELEMETRY__FILE__PATH=logs/otel.log
# TELEMETRY__FILE__MAX_BYTES=10485760    # 10 MB
# TELEMETRY__FILE__BACKUP_COUNT=5

# ── Logfire exporter ──────────────────────────────────────────
# Required when "logfire" is in TELEMETRY__EXPORTERS.
# Skipped with a warning if absent.
# TELEMETRY__LOGFIRE__TOKEN=your-logfire-project-token

# ── Custom endpoint exporter ──────────────────────────────────
# Required when "custom" is in TELEMETRY__EXPORTERS.
# TELEMETRY__CUSTOM__ENDPOINT=http://localhost:4318

# ── Per-component log levels ──────────────────────────────────
# JSON object mapping logger name → level string.
# "root" maps to the root Python logger.
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# TELEMETRY__LOG_LEVELS='{"root":"INFO","app.services":"DEBUG"}'

# ============================================================
# Frontend (Vite)
# ============================================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8002/ws
VITE_OIDC_AUTHORITY=http://localhost:8082/realms/parthenon
VITE_OIDC_CLIENT_ID=parthenon-api-ui

# ============================================================
# Service Decomposition — per-service environment variables
# ============================================================
# Each of the three backend services uses a SUBSET of these
# variables.  See the table below for which service needs what.
#
#  Variable                       CC   AR   CH
#  ─────────────────────────────  ───  ───  ───
#  DATABASE_URL / POSTGRES_*      ✓    –    –
#  REDIS_URL / REDIS_*            ✓    –    ✓
#  OIDC_PROVIDER_URL              ✓    ✓    ✓
#  AGENT_RUNTIME_BOOTSTRAP_KEY    ✓    –    –
#  COMM_HUB_BOOTSTRAP_KEY         ✓    –    –
#  CONTROL_CENTER_URL             –    ✓    ✓
#  SERVICE_BOOTSTRAP_KEY          –    ✓    ✓
#
# CC = Control Center (port 8000)
# AR = Agent Runtime  (port 8001)
# CH = Communication Hub (port 8002)
# ============================================================

# ------------------------------------------------------------
# Control Center only
# ------------------------------------------------------------
# Bootstrap keys — must be at least 32 characters.
# AR service must present AGENT_RUNTIME_BOOTSTRAP_KEY to receive its cert.
# CH service must present COMM_HUB_BOOTSTRAP_KEY to receive its cert.
AGENT_RUNTIME_BOOTSTRAP_KEY=change-me-agent-runtime-bootstrap-key!!
COMM_HUB_BOOTSTRAP_KEY=change-me-comm-hub-bootstrap-key-here!!
TEST_SERVICE_BOOTSTRAP_KEY=change-me-test-service-bootstrap-key!!

# ------------------------------------------------------------
# Agent Runtime only
# ------------------------------------------------------------
# URL of the Control Center service (internal network)
CONTROL_CENTER_URL=http://localhost:8000
# Certificate paths for mTLS authentication (will be created on first bootstrap)
AGENT_CERT_PATH=certs/agent-runtime-cert.pem
AGENT_KEY_PATH=certs/agent-runtime-key.pem
CA_CERT_PATH=certs/ca-cert.pem
# Must match the AGENT_RUNTIME_BOOTSTRAP_KEY set in Control Center
# SERVICE_BOOTSTRAP_KEY=<same value as AGENT_RUNTIME_BOOTSTRAP_KEY>

# ------------------------------------------------------------
# Communication Hub only  (also set CONTROL_CENTER_URL above)
# ------------------------------------------------------------
# Certificate paths for mTLS authentication (will be created on first bootstrap)
COMM_HUB_CERT_PATH=certs/communication-hub-cert.pem
COMM_HUB_KEY_PATH=certs/communication-hub-key.pem
# CA_CERT_PATH is shared with Agent Runtime (defined above)
# Must match the COMM_HUB_BOOTSTRAP_KEY set in Control Center
# SERVICE_BOOTSTRAP_KEY=<same value as COMM_HUB_BOOTSTRAP_KEY>
